# Clerk — dante.id is a SATELLITE of the perea.company Clerk production instance.
# Copy to .env.local for local dev, and set the same vars in Vercel (Production).

# Publishable key of the PRIMARY (perea.company) Clerk instance — dante.id shares it.
# It is the pk_live_… key, NOT a new app's key. (Publishable keys are safe in the client.)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The domain Clerk should treat as the satellite (this site).
VITE_CLERK_SATELLITE_DOMAIN=dante.id

# Where the sign-in flow actually runs — the PRIMARY domain's hosted page.
# Approved waitlist users authenticate there, then return to dante.id.
VITE_CLERK_PRIMARY_SIGN_IN_URL=https://perea.company/sign-in

# Local route that renders the first-party Clerk-backed waitlist form.
VITE_CLERK_WAITLIST_URL=/waitlist

# Where to land the user on dante.id after auth completes and syncs back.
VITE_CLERK_AFTER_SIGN_IN_URL=/
